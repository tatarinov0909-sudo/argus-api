// =====================================================================
// Аргус — выгрузка справочников из 1С:Управление торговлей 10.3
// Платформа 8.3, обычные формы, толстый клиент.
//
// ТОЛЬКО ЧТЕНИЕ. Обработка не создаёт, не изменяет и не проводит
// ни одного объекта в базе. Пишет один JSON-файл на диск.
//
// Написано защитно: состав реквизитов в доработанных базах отличается,
// поэтому всё необязательное проверяется через Метаданные перед чтением,
// а не предполагается. Если реквизита нет — поле уедет пустым, но
// выгрузка не упадёт.
// =====================================================================

Перем мОшибки;


Функция ЕстьРеквизитСправочника(ИмяСправочника, ИмяРеквизита)
	МетаСправочник = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаСправочник = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат МетаСправочник.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
КонецФункции


// Ссылка 1С -> строковый GUID. Это и есть external_id на стороне Аргуса:
// код и наименование могут меняться, а идентификатор — нет.
Функция ИдентификаторСсылки(Ссылка)
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции


Функция ЧислоИлиПусто(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ч = Число(Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ч = 0 Тогда
		// Ноль в 1С почти всегда означает "не заполнено", а не "весит 0 кг".
		// Отдаём пустоту, чтобы Аргус не принял это за настоящий габарит.
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ч;
КонецФункции


Функция СобратьКонтрагентов()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Ссылка          КАК Ссылка,
	|	К.Код             КАК Код,
	|	К.Наименование    КАК Наименование
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	НЕ К.ПометкаУдаления
	|	И НЕ К.ЭтоГруппа
	|УПОРЯДОЧИТЬ ПО
	|	К.Наименование";

	ЕстьИНН = ЕстьРеквизитСправочника("Контрагенты", "ИНН");

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("externalId", ИдентификаторСсылки(Выборка.Ссылка));
		Стр.Вставить("code",       Выборка.Код);
		Стр.Вставить("name",       СокрЛП(Выборка.Наименование));
		Если ЕстьИНН Тогда
			Попытка
				Стр.Вставить("inn", СокрЛП(Выборка.Ссылка.ИНН));
			Исключение
				Стр.Вставить("inn", Неопределено);
			КонецПопытки;
		КонецЕсли;
		Результат.Добавить(Стр);
	КонецЦикла;

	Возврат Результат;

КонецФункции


Функция СобратьНоменклатуру()

	// В запрос берём только то, что есть в УТ 10.3 всегда. Всё остальное
	// (вес, объём) дочитываем по ссылке ниже — в доработанных базах эти
	// реквизиты могут отсутствовать или лежать в другом месте.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Ссылка                     КАК Ссылка,
	|	Н.Код                        КАК Код,
	|	Н.Наименование               КАК Наименование,
	|	Н.Артикул                    КАК Артикул,
	|	Н.НоменклатурнаяГруппа       КАК Группа,
	|	Н.БазоваяЕдиницаИзмерения    КАК Единица
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ПометкаУдаления
	|	И НЕ Н.ЭтоГруппа
	|УПОРЯДОЧИТЬ ПО
	|	Н.Наименование";

	// Вес и объём в УТ 10.3 живут на единице измерения, а не на самой
	// номенклатуре. Проверяем оба места — в доработках встречается и так, и так.
	ВесНаНоменклатуре   = ЕстьРеквизитСправочника("Номенклатура", "Вес");
	ОбъемНаНоменклатуре = ЕстьРеквизитСправочника("Номенклатура", "Объем");
	ВесНаЕдинице        = ЕстьРеквизитСправочника("ЕдиницыИзмерения", "Вес");
	ОбъемНаЕдинице      = ЕстьРеквизитСправочника("ЕдиницыИзмерения", "Объем");

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Вес   = Неопределено;
		Объем = Неопределено;

		Попытка
			Если ВесНаНоменклатуре Тогда
				Вес = ЧислоИлиПусто(Выборка.Ссылка.Вес);
			КонецЕсли;
			Если Вес = Неопределено И ВесНаЕдинице И ЗначениеЗаполнено(Выборка.Единица) Тогда
				Вес = ЧислоИлиПусто(Выборка.Единица.Вес);
			КонецЕсли;

			Если ОбъемНаНоменклатуре Тогда
				Объем = ЧислоИлиПусто(Выборка.Ссылка.Объем);
			КонецЕсли;
			Если Объем = Неопределено И ОбъемНаЕдинице И ЗначениеЗаполнено(Выборка.Единица) Тогда
				Объем = ЧислоИлиПусто(Выборка.Единица.Объем);
			КонецЕсли;
		Исключение
			мОшибки.Добавить("Не удалось прочитать вес/объём: " + Выборка.Наименование);
		КонецПопытки;

		Стр = Новый Структура;
		Стр.Вставить("externalId", ИдентификаторСсылки(Выборка.Ссылка));
		Стр.Вставить("code",       Выборка.Код);
		Стр.Вставить("sku",        СокрЛП(Выборка.Артикул));
		Стр.Вставить("name",       СокрЛП(Выборка.Наименование));
		Стр.Вставить("category",   ?(ЗначениеЗаполнено(Выборка.Группа),  СокрЛП(Строка(Выборка.Группа)),  Неопределено));
		Стр.Вставить("unit",       ?(ЗначениеЗаполнено(Выборка.Единица), СокрЛП(Строка(Выборка.Единица)), Неопределено));
		Стр.Вставить("weight",     Вес);
		Стр.Вставить("volume",     Объем);

		Результат.Добавить(Стр);

	КонецЦикла;

	Возврат Результат;

КонецФункции


// Сводка по качеству данных. Смотреть на неё нужно раньше, чем на сами
// данные: если габариты не заполнены ни у кого, подбор ячейки по размеру
// строить не на чем, и это надо знать до того, как он написан.
Функция СобратьСводку(Контрагенты, Номенклатура)

	БезАртикула = 0;
	БезВеса     = 0;
	БезОбъема   = 0;
	БезГруппы   = 0;
	Артикулы    = Новый Соответствие;
	Дубли       = 0;

	Для Каждого Товар Из Номенклатура Цикл
		Если ПустаяСтрока(Товар.sku) Тогда
			БезАртикула = БезАртикула + 1;
		Иначе
			Если Артикулы[ВРег(Товар.sku)] = Неопределено Тогда
				Артикулы.Вставить(ВРег(Товар.sku), 1);
			Иначе
				Дубли = Дубли + 1;
			КонецЕсли;
		КонецЕсли;
		Если Товар.weight   = Неопределено Тогда БезВеса   = БезВеса   + 1; КонецЕсли;
		Если Товар.volume   = Неопределено Тогда БезОбъема = БезОбъема + 1; КонецЕсли;
		Если Товар.category = Неопределено Тогда БезГруппы = БезГруппы + 1; КонецЕсли;
	КонецЦикла;

	Сводка = Новый Структура;
	Сводка.Вставить("counterparties",     Контрагенты.Количество());
	Сводка.Вставить("products",           Номенклатура.Количество());
	Сводка.Вставить("productsNoSku",      БезАртикула);
	Сводка.Вставить("productsDuplicateSku", Дубли);
	Сводка.Вставить("productsNoWeight",   БезВеса);
	Сводка.Вставить("productsNoVolume",   БезОбъема);
	Сводка.Вставить("productsNoCategory", БезГруппы);
	Возврат Сводка;

КонецФункции


Процедура ВыгрузитьВыполнить(Кнопка)

	Если ПустаяСтрока(ПутьФайла) Тогда
		Предупреждение("Укажите, куда сохранить файл");
		Возврат;
	КонецЕсли;

	мОшибки = Новый Массив;
	Состояние("Аргус: читаем справочники...");

	Попытка
		Контрагенты  = СобратьКонтрагентов();
		Номенклатура = СобратьНоменклатуру();
	Исключение
		Предупреждение("Не удалось прочитать справочники:" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Выгрузка = Новый Структура;
	Выгрузка.Вставить("source",        "1C:УТ 10.3");
	Выгрузка.Вставить("exportedAt",    Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Выгрузка.Вставить("summary",       СобратьСводку(Контрагенты, Номенклатура));
	Выгрузка.Вставить("counterparties", Контрагенты);
	Выгрузка.Вставить("products",       Номенклатура);
	Выгрузка.Вставить("readErrors",     мОшибки);

	Попытка
		Запись = Новый ЗаписьJSON;
		Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
		Запись.ОткрытьФайл(ПутьФайла, "UTF-8", Ложь, Параметры);
		ЗаписатьJSON(Запись, Выгрузка);
		Запись.Закрыть();
	Исключение
		Предупреждение("Не удалось записать файл:" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	С = Выгрузка.summary;
	Текст = "Готово." + Символы.ПС + Символы.ПС
		+ "Контрагентов: " + С.counterparties + Символы.ПС
		+ "Номенклатуры: " + С.products + Символы.ПС + Символы.ПС
		+ "Без артикула: "        + С.productsNoSku + Символы.ПС
		+ "Дублей артикула: "     + С.productsDuplicateSku + Символы.ПС
		+ "Без веса: "            + С.productsNoWeight + Символы.ПС
		+ "Без объёма: "          + С.productsNoVolume + Символы.ПС
		+ "Без группы: "          + С.productsNoCategory;

	Предупреждение(Текст);

КонецПроцедуры


Процедура ПриОткрытии()
	ПутьФайла = "C:\argus_1c_export.json";
КонецПроцедуры
