// =====================================================================
// Аргус — реальная выгрузка в облако (не в файл).
// 1С:Управление торговлей 10.3, платформа 8.3, обычные формы.
//
// Что делает: подключается к https://api.argus-ai.online по ключу
// интеграции, отправляет контрагентов и номенклатуру. Товар и заказы
// НЕ создаются и НЕ изменяются в 1С — только чтение справочников
// и передача наружу. Провести/изменить документ эта обработка не может.
//
// Отличие от ВыгрузкаСправочников.bsl: та писала JSON-файл на диск для
// разовой проверки. Эта — реальный канал связи, тот же алгоритм сбора
// данных, но результат уходит по HTTPS, а не в файл.
// =====================================================================

Перем мТокенДоступа;
Перем мИдСклада;


Функция НовоеСоединение()
	// 443 + Истина — стандартный HTTPS с проверкой сертификата через
	// системное доверенное хранилище. Отдельный сертификат не нужен —
	// на сервере действующий Let's Encrypt.
	// Последний параметр (Истина) — забирать настройки прокси из Windows
	// автоматически: в офисных сетях выход в интернет часто идёт только
	// через прокси, и без этого параметра прямое соединение может тихо
	// не устанавливаться (без исключения, с пустым ответом).
	Возврат Новый HTTPСоединение("api.argus-ai.online", 443, , , , 30, Истина, Истина);
КонецФункции


Функция СтрокаИзJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции


Функция ЗначениеИзJSON(Строка)
	Если ПустаяСтрока(Строка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Строка);
	Результат = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции


// Возвращает Структура(Успех, Тело) — Успех = Ложь при сетевой ошибке
// или коде ответа вне 200-299, чтобы вызывающий код не падал целиком
// из-за одной неудачной попытки, а мог показать внятное сообщение.
Функция ВыполнитьЗапрос(Метод, Путь, Тело, Знач ТребуетсяАвторизация = Истина)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Если ТребуетсяАвторизация Тогда
		Если ПустаяСтрока(мТокенДоступа) Тогда
			Возврат Новый Структура("Успех, Ошибка", Ложь, "Нет токена — сначала выполните подключение");
		КонецЕсли;
		Заголовки.Вставить("Authorization", "Bearer " + мТокенДоступа);
	КонецЕсли;

	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Если Тело <> Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(СтрокаИзJSON(Тело), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Попытка
		Соединение = НовоеСоединение();
		Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Исключение
		Возврат Новый Структура("Успех, Ошибка", Ложь,
			"Не удалось подключиться к серверу. Проверьте, что у этого компьютера есть выход в интернет "
			+ "и ничего не блокирует HTTPS на api.argus-ai.online." + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;

	Если Ответ = Неопределено Тогда
		Возврат Новый Структура("Успех, Ошибка", Ложь,
			"Сервер не ответил (пустой результат без ошибки). Обычно значит, что прямое HTTPS-соединение "
			+ "не проходит из этой сети — возможно, требуется прокси, и его не удалось определить "
			+ "автоматически. Уточните у вашего IT-администратора, нужен ли прокси для выхода в интернет.");
	КонецЕсли;

	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	РазобранноеТело = Неопределено;
	Попытка
		РазобранноеТело = ЗначениеИзJSON(ТелоОтвета);
	Исключение
		// Сервер мог ответить не-JSON текстом (например, при ошибке на уровне
		// nginx) — это не должно ронять обработку, просто нечего разобрать.
	КонецПопытки;

	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ТекстОшибки = "Сервер ответил " + Ответ.КодСостояния;
		Если РазобранноеТело <> Неопределено И РазобранноеТело.Свойство("error") Тогда
			ТекстОшибки = ТекстОшибки + ": " + РазобранноеТело.error;
		КонецЕсли;
		Возврат Новый Структура("Успех, Ошибка", Ложь, ТекстОшибки);
	КонецЕсли;

	Возврат Новый Структура("Успех, Тело", Истина, РазобранноеТело);

КонецФункции


// ===================== Сбор данных (тот же принцип, что и в файловой версии) =====================

Функция ЕстьРеквизитСправочника(ИмяСправочника, ИмяРеквизита)
	МетаСправочник = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаСправочник = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат МетаСправочник.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
КонецФункции

Функция ИдентификаторСсылки(Ссылка)
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция ЧислоИлиПусто(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ч = Число(Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ч = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ч;
КонецФункции

Функция СобратьКонтрагентовДляОтправки()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Ссылка КАК Ссылка,
	|	К.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	НЕ К.ПометкаУдаления
	|	И НЕ К.ЭтоГруппа";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("externalId", ИдентификаторСсылки(Выборка.Ссылка));
		Стр.Вставить("name", СокрЛП(Выборка.Наименование));
		Результат.Добавить(Стр);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СобратьНоменклатуруДляОтправки()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Ссылка,
	|	Н.Наименование КАК Наименование,
	|	Н.Код КАК Код,
	|	Н.НоменклатурнаяГруппа КАК Группа,
	|	Н.БазоваяЕдиницаИзмерения КАК Единица
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ПометкаУдаления
	|	И НЕ Н.ЭтоГруппа";
	// Примечание: "ГоловнойКонтрагент" — не стандартный реквизит УТ 10.3.
	// В большинстве баз номенклатура НЕ привязана к конкретному контрагенту
	// напрямую (в отличие от нашей модели, где товар принадлежит продавцу).
	// Если в вашей базе такого реквизита нет, снимите эту строку и раздел
	// "companyExternalId" ниже — тогда каждую позицию перед отправкой нужно
	// будет вручную сопоставить с компанией в личном кабинете Аргуса.

	ВесНаНоменклатуре   = ЕстьРеквизитСправочника("Номенклатура", "Вес");
	ВесНаЕдинице        = ЕстьРеквизитСправочника("ЕдиницыИзмерения", "Вес");

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Код = СокрЛП(Выборка.Код);
		Если ПустаяСтрока(Код) Тогда
			Продолжить; // без кода сопоставить с нашим SKU нечем
		КонецЕсли;

		// Нужны только позиции с латинским префиксом "PB" (P=U+0050, B=U+0042)
		// в поле "Код" — не в Артикуле, подтверждено владельцем базы напрямую.
		// Кириллическое "ПБ" на экране выглядит почти так же, но это другой
		// префикс — старые/чужие позиции, их пропускаем. Поэтому здесь важно,
		// чтобы в этих кавычках стояла именно латиница, а не кириллица — при
		// правке этой строки набирайте "PB" на английской раскладке.
		Если Не СтрНачинаетсяС(ВРег(Код), "PB") Тогда
			Продолжить;
		КонецЕсли;

		Вес = Неопределено;
		Попытка
			Если ВесНаНоменклатуре Тогда Вес = ЧислоИлиПусто(Выборка.Ссылка.Вес); КонецЕсли;
			Если Вес = Неопределено И ВесНаЕдинице И ЗначениеЗаполнено(Выборка.Единица) Тогда
				Вес = ЧислоИлиПусто(Выборка.Единица.Вес);
			КонецЕсли;
		Исключение
		КонецПопытки;

		// Наш сервер понимает только lengthMm/widthMm/heightMm/weightG — единого
		// поля "объём" в модели товара нет намеренно, для подбора ячейки нужны
		// именно три измерения, а не итоговый м³. "Объём" (Объем) из 1С почти
		// никогда не раскладывается однозначно на длину/ширину/высоту, поэтому
		// сюда НЕ идёт — если у вас в базе всё же есть отдельные реквизиты для
		// каждого измерения, допишите их чтение по аналогии с Вес выше.
		// "Вес" в УТ 10.3 хранится в килограммах по умолчанию — переводим
		// в граммы, потому что так называется поле в нашем API (weightG).
		// Если в вашей базе единица веса другая — эту строку нужно поправить,
		// первую реальную выгрузку стоит свериться через ВыгрузкаСправочников.bsl.
		ВесВГраммах = Неопределено;
		Если Вес <> Неопределено Тогда
			ВесВГраммах = Вес * 1000;
		КонецЕсли;

		Стр = Новый Структура;
		Стр.Вставить("externalId", ИдентификаторСсылки(Выборка.Ссылка));
		Стр.Вставить("sku",        Код);
		Стр.Вставить("name",       СокрЛП(Выборка.Наименование));
		Стр.Вставить("category",   ?(ЗначениеЗаполнено(Выборка.Группа), СокрЛП(Строка(Выборка.Группа)), Неопределено));
		Стр.Вставить("weightG",    ВесВГраммах);
		// В этой базе у номенклатуры нет привязки к компании-продавцу —
		// companyExternalId не заполняем, компанию для этих товаров назначим
		// в личном кабинете Аргуса отдельно.
		Стр.Вставить("companyExternalId", Неопределено);

		Результат.Добавить(Стр);

	КонецЦикла;
	Возврат Результат;
КонецФункции


Функция СобратьНакладныеДляОтправки()
	// Источник — "Заказ поставщику": заявленное количество товара ДО того,
	// как он физически приехал на склад. Это и есть накладная в смысле
	// Аргуса — работник сверяет с ней факт при приёмке. "Поступление"
	// (когда товар уже принят и остаток уже сдвинут) сюда сознательно не
	// идёт — иначе Аргус получал бы уже свершившийся факт, а не то, с чем
	// нужно сверяться.
	//
	// Ограничение по дате — чтобы не тащить в Аргус многолетнюю историю
	// старых, давно закрытых заказов, только недавние/актуальные.
	ДатаОт = НачалоДня(ТекущаяДата() - 60 * 24 * 60 * 60);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗП.Ссылка КАК Ссылка,
	|	ЗП.Номер КАК Номер
	|ИЗ
	|	Документ.ЗаказПоставщику КАК ЗП
	|ГДЕ
	|	ЗП.Проведен
	|	И ЗП.Дата >= &ДатаОт";
	Запрос.УстановитьПараметр("ДатаОт", ДатаОт);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ЗапросПозиций = Новый Запрос;
		ЗапросПозиций.Текст =
		"ВЫБРАТЬ
		|	Т.Номенклатура.Код КАК Код,
		|	Т.Номенклатура.Наименование КАК Наименование,
		|	Т.Количество КАК Количество
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
		ЗапросПозиций.УстановитьПараметр("Ссылка", Выборка.Ссылка);

		Позиции = Новый Массив;
		ВыборкаПозиций = ЗапросПозиций.Выполнить().Выбрать();
		Пока ВыборкаПозиций.Следующий() Цикл
			Код = СокрЛП(ВыборкаПозиций.Код);
			// Тот же фильтр, что и в номенклатуре — берём только те позиции,
			// артикул которых мы вообще синхронизировали (латинский префикс
			// "PB" в "Коде"). Иначе в накладную попадут строки с SKU, которых
			// в Аргусе никогда не было.
			Если ПустаяСтрока(Код) Или Не СтрНачинаетсяС(ВРег(Код), "PB") Тогда
				Продолжить;
			КонецЕсли;

			СтрПозиции = Новый Структура;
			СтрПозиции.Вставить("sku", Код);
			СтрПозиции.Вставить("name", СокрЛП(ВыборкаПозиций.Наименование));
			СтрПозиции.Вставить("declaredQty", ЧислоИлиПусто(ВыборкаПозиций.Количество));
			Позиции.Добавить(СтрПозиции);
		КонецЦикла;

		Если Позиции.Количество() = 0 Тогда
			Продолжить; // ни одной узнаваемой позиции — нечего отправлять
		КонецЕсли;

		Стр = Новый Структура;
		Стр.Вставить("externalId", ИдентификаторСсылки(Выборка.Ссылка));
		Стр.Вставить("number", СокрЛП(Выборка.Номер));
		Стр.Вставить("direction", "in");
		// companyExternalId не заполняем — как и в номенклатуре, в этой базе
		// нет однозначной связи с компанией-продавцом в терминах Аргуса.
		// Уходит под ту же "HappyLand Test", что и товары (defaultCompanyName).
		Стр.Вставить("items", Позиции);

		Результат.Добавить(Стр);

	КонецЦикла;
	Возврат Результат;
КонецФункции


// ===================== Команды формы =====================

// Пишет строку в лог-файл вместо модального окна. Планировщик Windows
// запускает 1С без человека за экраном — Предупреждение() там никто не
// увидит и не закроет, вся синхронизация зависла бы навсегда. Файл кладётся
// в текущий рабочий каталог процесса 1С — его задаёт .bat через "cd /d",
// см. 1c-module/README.md, раздел про автозапуск по расписанию.
Процедура ЗаписьЖурнала(Текст)
	Попытка
		Запись = Новый ЗаписьТекста("argus_sync.log", КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку(Строка(ТекущаяДата()) + "  " + Текст);
		Запись.Закрыть();
	Исключение
		// Не удалось записать лог (нет прав на каталог и т.п.) — прерывать
		// синхронизацию из-за этого не надо, само событие уже произошло.
	КонецПопытки;
КонецПроцедуры

// Общая точка вывода для всех команд ниже: интерактивно — модальное окно,
// как раньше; в автоматическом запуске (Тихо=Истина) — строка в лог-файл.
Процедура ПоказатьРезультат(Текст, Знач Тихо)
	Если Тихо Тогда
		ЗаписьЖурнала(СтрЗаменить(Текст, Символы.ПС, "; "));
	Иначе
		Предупреждение(Текст);
	КонецЕсли;
КонецПроцедуры


Процедура ПодключитьсяВыполнить(Кнопка, Знач Тихо = Ложь)

	// Платформа при вызове с кнопки формы подставляет необязательные
	// параметры явным Неопределено, а не значением по умолчанию — без этой
	// строки "Если Не Тихо Тогда" падает с "Преобразование к типу Булево
	// не может быть выполнено". Приводим к настоящему Булеву в любом случае.
	Тихо = (Тихо = Истина);

	Если ПустаяСтрока(КлючИнтеграции) Тогда
		ПоказатьРезультат("Введите ключ интеграции — его выдаёт владелец склада в личном кабинете Аргуса.", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
		Состояние("Подключение к Аргусу...");
	КонецЕсли;
	Ответ = ВыполнитьЗапрос("POST", "/api/sync/auth",
		Новый Структура("keyCode", СокрЛП(КлючИнтеграции)), Ложь);

	Если Не Ответ.Успех Тогда
		ПоказатьРезультат("Не удалось подключиться:" + Символы.ПС + Ответ.Ошибка, Тихо);
		Возврат;
	КонецЕсли;

	мТокенДоступа = Ответ.Тело.token;
	мИдСклада = Ответ.Тело.warehouseId;
	СтатусПодключения = "Подключено. Склад: " + мИдСклада;
	ПоказатьРезультат("Подключение установлено. Склад: " + мИдСклада, Тихо);

КонецПроцедуры


Процедура ОтправитьКонтрагентовВыполнить(Кнопка, Знач Тихо = Ложь)

	Тихо = (Тихо = Истина);

	Если ПустаяСтрока(мТокенДоступа) Тогда
		ПоказатьРезультат("Сначала нажмите «Подключиться».", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
		Состояние("Собираем контрагентов...");
	КонецЕсли;
	Записи = СобратьКонтрагентовДляОтправки();
	Если Записи.Количество() = 0 Тогда
		ПоказатьРезультат("Контрагентов для отправки не найдено.", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
		Состояние("Отправляем " + Записи.Количество() + " контрагентов...");
	КонецЕсли;
	Ответ = ВыполнитьЗапрос("POST", "/api/sync/push/companies", Новый Структура("records", Записи));

	Если Не Ответ.Успех Тогда
		ПоказатьРезультат("Ошибка отправки:" + Символы.ПС + Ответ.Ошибка, Тихо);
		Возврат;
	КонецЕсли;

	ПоказатьСводкуОтправки("Контрагенты", Ответ.Тело, Тихо);

КонецПроцедуры


Процедура ОтправитьНоменклатуруВыполнить(Кнопка, Знач Тихо = Ложь)

	Тихо = (Тихо = Истина);

	Если ПустаяСтрока(мТокенДоступа) Тогда
		ПоказатьРезультат("Сначала нажмите «Подключиться».", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
		Состояние("Собираем номенклатуру...");
	КонецЕсли;
	Записи = СобратьНоменклатуруДляОтправки();
	Если Записи.Количество() = 0 Тогда
		ПоказатьРезультат("Номенклатуры для отправки не найдено (возможно, не заполнены артикулы).", Тихо);
		Возврат;
	КонецЕсли;

	// Отправляем пачками по 500 — ровно лимит на стороне сервера, см. sync/routes.js.
	РазмерПачки = 500;
	Номер = 0;
	ВсегоСоздано = 0; ВсегоОбновлено = 0; ВсегоОшибок = 0;
	Пока Номер < Записи.Количество() Цикл
		Пачка = Новый Массив;
		Граница = Мин(Номер + РазмерПачки, Записи.Количество());
		Для Инд = Номер По Граница - 1 Цикл
			Пачка.Добавить(Записи[Инд]);
		КонецЦикла;

		Если Не Тихо Тогда
			Состояние("Отправляем позиции " + (Номер + 1) + "–" + Граница + " из " + Записи.Количество() + "...");
		КонецЕсли;
		// "HappyLand Test" — компания, заранее созданная владельцем в кабинете
		// Аргуса. В этой базе номенклатура не привязана к контрагенту, поэтому
		// весь пуш идёт под одну явно указанную компанию, а не по externalId.
		Тело = Новый Структура;
		Тело.Вставить("records", Пачка);
		Тело.Вставить("defaultCompanyName", "HappyLand Test");
		Ответ = ВыполнитьЗапрос("POST", "/api/sync/push/products", Тело);
		Если Не Ответ.Успех Тогда
			ПоказатьРезультат("Ошибка отправки пачки " + (Номер + 1) + "–" + Граница + ":" + Символы.ПС + Ответ.Ошибка, Тихо);
			Возврат;
		КонецЕсли;

		Если Ответ.Тело.summary.Свойство("created") Тогда ВсегоСоздано = ВсегоСоздано + Ответ.Тело.summary.created; КонецЕсли;
		Если Ответ.Тело.summary.Свойство("updated") Тогда ВсегоОбновлено = ВсегоОбновлено + Ответ.Тело.summary.updated; КонецЕсли;
		Если Ответ.Тело.summary.Свойство("error") Тогда ВсегоОшибок = ВсегоОшибок + Ответ.Тело.summary.error; КонецЕсли;

		Номер = Граница;
	КонецЦикла;

	ПоказатьРезультат("Готово." + Символы.ПС
		+ "Создано: " + ВсегоСоздано + Символы.ПС
		+ "Обновлено: " + ВсегоОбновлено + Символы.ПС
		+ "Ошибок: " + ВсегоОшибок + Символы.ПС
		+ Символы.ПС
		+ "Если ошибок много — скорее всего, у товаров не заполнен контрагент "
		+ "(companyExternalId). См. комментарий в коде функции сбора номенклатуры.", Тихо);

КонецПроцедуры


Процедура ОтправитьНакладныеВыполнить(Кнопка, Знач Тихо = Ложь)

	Тихо = (Тихо = Истина);

	Если ПустаяСтрока(мТокенДоступа) Тогда
		ПоказатьРезультат("Сначала нажмите «Подключиться».", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
		Состояние("Собираем заказы поставщику...");
	КонецЕсли;
	Записи = СобратьНакладныеДляОтправки();
	Если Записи.Количество() = 0 Тогда
		ПоказатьРезультат("Накладных для отправки не найдено (за последние 60 дней нет проведённых заказов поставщику с узнаваемыми позициями).", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
