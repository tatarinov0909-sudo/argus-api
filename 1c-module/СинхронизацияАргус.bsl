// =====================================================================
// Аргус — реальная выгрузка в облако (не в файл).
// 1С:Управление торговлей 10.3, платформа 8.3, обычные формы.
//
// Что делает: подключается к https://api.argus-ai.online по ключу
// интеграции, отправляет контрагентов и номенклатуру. Товар и заказы
// НЕ создаются и НЕ изменяются в 1С — только чтение справочников
// и передача наружу. Провести/изменить документ эта обработка не может.
//
// Раньше рядом лежала вторая обработка — она писала те же данные в JSON
// на диск для разовой проверки. Слита сюда: кнопка «Выгрузить в файл»
// зовёт те же функции сбора, что и отправка, поэтому файл и сервер
// больше не могут показывать разное.
// =====================================================================

Перем мТокенДоступа;
Перем мИдСклада;
// Куда пишет «Выгрузить в файл». Намеренно переменная модуля, а не
// реквизит формы: поле ввода — ещё один элемент, который человеку
// нужно заводить руками в Конфигураторе, а менять этот путь в жизни
// некому. Понадобится другой — поправить здесь одну строку.
Перем ПутьФайла;


Функция НовоеСоединение()
	// 443 + Истина — стандартный HTTPS с проверкой сертификата через
	// системное доверенное хранилище. Отдельный сертификат не нужен —
	// на сервере действующий Let's Encrypt.
	// Последний параметр (Истина) — забирать настройки прокси из Windows
	// автоматически: в офисных сетях выход в интернет часто идёт только
	// через прокси, и без этого параметра прямое соединение может тихо
	// не устанавливаться (без исключения, с пустым ответом).
	Возврат Новый HTTPСоединение("api.argus-ai.online", 443, , , , 30, Истина, Истина);
КонецФункции


Функция СтрокаИзJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции


Функция ЗначениеИзJSON(Строка)
	Если ПустаяСтрока(Строка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Строка);
	Результат = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции


// Возвращает Структура(Успех, Тело) — Успех = Ложь при сетевой ошибке
// или коде ответа вне 200-299, чтобы вызывающий код не падал целиком
// из-за одной неудачной попытки, а мог показать внятное сообщение.
Функция ВыполнитьЗапрос(Метод, Путь, Тело, Знач ТребуетсяАвторизация = Истина)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Если ТребуетсяАвторизация Тогда
		Если ПустаяСтрока(мТокенДоступа) Тогда
			Возврат Новый Структура("Успех, Ошибка", Ложь, "Нет токена — сначала выполните подключение");
		КонецЕсли;
		Заголовки.Вставить("Authorization", "Bearer " + мТокенДоступа);
	КонецЕсли;

	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Если Тело <> Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(СтрокаИзJSON(Тело), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Попытка
		Соединение = НовоеСоединение();
		Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Исключение
		Возврат Новый Структура("Успех, Ошибка", Ложь,
			"Не удалось подключиться к серверу. Проверьте, что у этого компьютера есть выход в интернет "
			+ "и ничего не блокирует HTTPS на api.argus-ai.online." + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;

	Если Ответ = Неопределено Тогда
		Возврат Новый Структура("Успех, Ошибка", Ложь,
			"Сервер не ответил (пустой результат без ошибки). Обычно значит, что прямое HTTPS-соединение "
			+ "не проходит из этой сети — возможно, требуется прокси, и его не удалось определить "
			+ "автоматически. Уточните у вашего IT-администратора, нужен ли прокси для выхода в интернет.");
	КонецЕсли;

	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	РазобранноеТело = Неопределено;
	Попытка
		РазобранноеТело = ЗначениеИзJSON(ТелоОтвета);
	Исключение
		// Сервер мог ответить не-JSON текстом (например, при ошибке на уровне
		// nginx) — это не должно ронять обработку, просто нечего разобрать.
	КонецПопытки;

	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ТекстОшибки = "Сервер ответил " + Ответ.КодСостояния;
		Если РазобранноеТело <> Неопределено И РазобранноеТело.Свойство("error") Тогда
			ТекстОшибки = ТекстОшибки + ": " + РазобранноеТело.error;
		КонецЕсли;
		Возврат Новый Структура("Успех, Ошибка", Ложь, ТекстОшибки);
	КонецЕсли;

	Возврат Новый Структура("Успех, Тело", Истина, РазобранноеТело);

КонецФункции


// ===================== Сбор данных (тот же принцип, что и в файловой версии) =====================

Функция ЕстьРеквизитСправочника(ИмяСправочника, ИмяРеквизита)
	МетаСправочник = Метаданные.Справочники.Найти(ИмяСправочника);
	Если МетаСправочник = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат МетаСправочник.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
КонецФункции

Функция ЕстьРеквизитДокумента(ИмяДокумента, ИмяРеквизита)
	МетаДокумент = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаДокумент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат МетаДокумент.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
КонецФункции

// Имена регистров в конфигурациях разные, и угадывать их в коде — способ
// однажды молча ничего не выгрузить. Поэтому ищем по метаданным.
//
// Поле с товаром ищем ПО ТИПУ, а не по имени. Дважды обжёгся на именах:
// сначала искал регистр с измерением "Номенклатура" и отбросил настоящий
// "ШтрихКоды", где номенклатура — реквизит; потом разрешил и реквизиты, но
// в УТ 10.3 это поле называется "Владелец" и тип у него составной
// (номенклатура ИЛИ характеристика). Имя поля — вопрос вкуса того, кто
// рисовал конфигурацию, а тип — нет.
Функция НайтиПолеНоменклатуры(МетаРегистр)
	ТипНоменклатуры = Тип("СправочникСсылка.Номенклатура");
	Наборы = Новый Массив;
	Наборы.Добавить(МетаРегистр.Измерения);
	Наборы.Добавить(МетаРегистр.Реквизиты);
	Для Каждого Набор Из Наборы Цикл
		Для Каждого Поле Из Набор Цикл
			Попытка
				Если Поле.Тип.СодержитТип(ТипНоменклатуры) Тогда
					Возврат Поле.Имя;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Возвращаем ВСЕ подходящие регистры, а не первый: в живой базе рядом с
// настоящим "ШтрихКоды" лежал пустой "ШтрихкодыДоп", и версия, бравшая
// первый попавшийся, собрала ровно ноль штрихкодов из двенадцати тысяч
// позиций — молча, потому что "регистр найден" и "в регистре что-то есть"
// это разные вещи.
Функция НайтиРегистрыСведенийПоСлову(Слово)
	Найденные = Новый Массив;
	Для Каждого МетаРегистр Из Метаданные.РегистрыСведений Цикл
		Если Найти(ВРег(МетаРегистр.Имя), ВРег(Слово)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НайтиПолеНоменклатуры(МетаРегистр) <> Неопределено Тогда
			Найденные.Добавить(МетаРегистр.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Найденные;
КонецФункции

// Поле с нужным словом в имени — где угодно: измерение, реквизит, ресурс.
Функция НайтиПолеПоСлову(МетаРегистр, Слово)
	Наборы = Новый Массив;
	Наборы.Добавить(МетаРегистр.Измерения);
	Наборы.Добавить(МетаРегистр.Реквизиты);
	Наборы.Добавить(МетаРегистр.Ресурсы);
	Для Каждого Набор Из Наборы Цикл
		Для Каждого Поле Из Набор Цикл
			Если Найти(ВРег(Поле.Имя), ВРег(Слово)) > 0 Тогда
				Возврат Поле.Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция НайтиРегистрНакопленияПоСлову(Слово)
	Для Каждого МетаРегистр Из Метаданные.РегистрыНакопления Цикл
		Если Найти(ВРег(МетаРегистр.Имя), ВРег(Слово)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если МетаРегистр.Измерения.Найти("Номенклатура") <> Неопределено Тогда
			Возврат МетаРегистр.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Штрихкоды: код номенклатуры -> один штрихкод.
//
// Штрихкод — единственный код, одинаковый во всех системах, потому что
// напечатан на коробке. На нём держатся сканирование при приёмке и выгрузка
// остатков в 1С продавца: наши коды с его кодами не совпадают, а штрихкод
// совпадает всегда.
//
// Читаем все регистры со словом "Штрих" и сливаем в один словарь: какой из
// них в этой базе настоящий, а какой пустой довесок, снаружи не угадать.
// Если у позиции их несколько, берём первый попавшийся: для поиска товара
// этого достаточно, а разбираться, какой "главный", — работа не наша.
Функция СобратьШтрихкодыИзРегистра(ИмяРегистра, Соответствие)

	Добавлено = 0;
	МетаРегистр = Метаданные.РегистрыСведений[ИмяРегистра];
	ПолеТовара = НайтиПолеНоменклатуры(МетаРегистр);
	ПолеШК     = НайтиПолеПоСлову(МетаРегистр, "ШТРИХ");
	Если ПолеТовара = Неопределено Или ПолеШК = Неопределено Тогда
		Возврат Добавлено;
	КонецЕсли;

	// ВЫРАЗИТЬ обязательно: поле с товаром бывает составного типа, и без
	// приведения у него нет ни Кода, ни ПометкиУдаления. Заодно это и фильтр —
	// строки, где лежит не номенклатура (характеристика, серия), дают NULL
	// и отсеиваются сами.
	Товар = "ВЫРАЗИТЬ(Р." + ПолеТовара + " КАК Справочник.Номенклатура)";

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	" + Товар + ".Код КАК Код,
	|	Р." + ПолеШК + " КАК Штрихкод
	|ИЗ
	|	РегистрСведений." + ИмяРегистра + " КАК Р
	|ГДЕ
	|	НЕ " + Товар + ".ПометкаУдаления";

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		// Запрос собран из имён метаданных: если этот регистр устроен иначе,
		// чем мы предположили, пропускаем его и идём к следующему, а не роняем
		// всю выгрузку.
		ЗаписьЖурнала("Штрихкоды (" + ИмяРегистра + "): запрос не выполнился — "
			+ ОписаниеОшибки());
		Возврат Добавлено;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		Код = СокрЛП(Строка(Выборка.Код));
		Штрихкод = СокрЛП(Строка(Выборка.Штрихкод));
		Если ПустаяСтрока(Код) Или ПустаяСтрока(Штрихкод) Тогда
			Продолжить;
		КонецЕсли;
		Если Соответствие[Код] = Неопределено Тогда
			Соответствие.Вставить(Код, Штрихкод);
			Добавлено = Добавлено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Добавлено;
КонецФункции

// Сколько строк регистра указывают НЕ на номенклатуру. У поля "Владелец" тип
// составной: туда же кладут характеристики и серии. Если наши товары ведут
// штрихкоды через характеристики, то по номенклатуре их не видно вовсе —
// и это разные истории: "штрихкоды не заводят" против "заводят, но не там".
Функция СосчитатьЧужиеВладельцы(ИмяРегистра)
	МетаРегистр = Метаданные.РегистрыСведений[ИмяРегистра];
	ПолеТовара = НайтиПолеНоменклатуры(МетаРегистр);
	Если ПолеТовара = Неопределено Тогда
		Возврат -1;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Всего
	|ИЗ
	|	РегистрСведений." + ИмяРегистра + " КАК Р
	|ГДЕ
	|	ВЫРАЗИТЬ(Р." + ПолеТовара + " КАК Справочник.Номенклатура) ЕСТЬ NULL";

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат -1;
	КонецПопытки;

	Если Выборка.Следующий() Тогда
		// Именно Число(), а не ЧислоИлиПусто: тот превращает ноль в
		// Неопределено — правильно для веса и остатка, но для счётчика ноль
		// это ответ, а не отсутствие ответа. Сравнение Неопределено с нулём
		// роняет всю проверку базы, что и случилось.
		Попытка
			Возврат Число(Выборка.Всего);
		Исключение
			Возврат -1;
		КонецПопытки;
	КонецЕсли;
	Возврат -1;
КонецФункции

Функция СобратьШтрихкоды()
	Соответствие = Новый Соответствие;
	Для Каждого ИмяРегистра Из НайтиРегистрыСведенийПоСлову("Штрих") Цикл
		СобратьШтрихкодыИзРегистра(ИмяРегистра, Соответствие);
	КонецЦикла;
	Возврат Соответствие;
КонецФункции

// Резервы: код номенклатуры -> сколько уже обещано заказам покупателей.
//
// В 1С проведённый заказ жёстко закрепляет товар, и взять его в другой заказ
// нельзя. Аргус про это не знает и видит только физический остаток в ячейках,
// поэтому может предложить работнику то, что уже обещано. Проявится в первый
// же день, когда на один дефицитный артикул придут два заказа.
Функция СобратьРезервы()
	Соответствие = Новый Соответствие;
	ИмяРегистра = НайтиРегистрНакопленияПоСлову("Резерв");
	Если ИмяРегистра = Неопределено Тогда
		Возврат Соответствие;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура.Код КАК Код,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления." + ИмяРегистра + ".Остатки КАК Остатки
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура.Код";

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ЗаписьЖурнала("Резервы: запрос не выполнился — " + ОписаниеОшибки());
		Возврат Соответствие;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		Код = СокрЛП(Выборка.Код);
		Если ПустаяСтрока(Код) Тогда
			Продолжить;
		КонецЕсли;
		Соответствие.Вставить(Код, ЧислоИлиПусто(Выборка.Количество));
	КонецЦикла;
	Возврат Соответствие;
КонецФункции

Функция ИдентификаторСсылки(Ссылка)
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция ЧислоИлиПусто(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ч = Число(Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ч = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ч;
КонецФункции

Функция СобратьКонтрагентовДляОтправки()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Ссылка КАК Ссылка,
	|	К.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	НЕ К.ПометкаУдаления
	|	И НЕ К.ЭтоГруппа";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("externalId", ИдентификаторСсылки(Выборка.Ссылка));
		Стр.Вставить("name", СокрЛП(Выборка.Наименование));
		Результат.Добавить(Стр);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СобратьНоменклатуруДляОтправки()

	ВесНаНоменклатуре = ЕстьРеквизитСправочника("Номенклатура", "Вес");
	ВесНаЕдинице      = ЕстьРеквизитСправочника("ЕдиницыИзмерения", "Вес");

	// Откуда брать единицу измерения. В УТ 10.3 "БазоваяЕдиницаИзмерения"
	// ссылается на классификатор ОКЕИ — там веса нет вовсе, там только
	// "штука" и "килограмм" как понятия. Вес лежит в "ЕдиницыИзмерения",
	// подчинённых самой номенклатуре, и ссылка на них — это
	// "ЕдиницаХраненияОстатков". Первая версия читала базовую, ловила
	// исключение на каждой позиции и отправила 12 001 товар без веса.
	ПолеЕдиницы = "";
	Если ЕстьРеквизитСправочника("Номенклатура", "ЕдиницаХраненияОстатков") Тогда
		ПолеЕдиницы = "ЕдиницаХраненияОстатков";
	ИначеЕсли ЕстьРеквизитСправочника("Номенклатура", "БазоваяЕдиницаИзмерения") Тогда
		ПолеЕдиницы = "БазоваяЕдиницаИзмерения";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Ссылка,
	|	Н.Наименование КАК Наименование,
	|	Н.Код КАК Код,
	|	Н.НоменклатурнаяГруппа КАК Группа"
	+ ?(ПустаяСтрока(ПолеЕдиницы), "", ",
	|	Н." + ПолеЕдиницы + " КАК Единица")
	+ "
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ПометкаУдаления
	|	И НЕ Н.ЭтоГруппа";

	// Примечание: "ГоловнойКонтрагент" — не стандартный реквизит УТ 10.3.
	// В большинстве баз номенклатура НЕ привязана к конкретному контрагенту
	// напрямую (в отличие от нашей модели, где товар принадлежит продавцу).
	// Если в вашей базе такого реквизита нет, снимите эту строку и раздел
	// "companyExternalId" ниже — тогда каждую позицию перед отправкой нужно
	// будет вручную сопоставить с компанией в личном кабинете Аргуса.

	// Оба словаря собираем один раз на всю выгрузку, а не запросом на каждую
	// позицию: номенклатуры одиннадцать тысяч, и запрос на каждую превратил
	// бы обмен в получасовой.
	Штрихкоды = СобратьШтрихкоды();
	Резервы   = СобратьРезервы();

	ОшибкаВеса = "";
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Код = СокрЛП(Выборка.Код);
		Если ПустаяСтрока(Код) Тогда
			Продолжить; // без кода сопоставить с нашим SKU нечем
		КонецЕсли;

		// Нужны только позиции с латинским префиксом "PB" (P=U+0050, B=U+0042)
		// в поле "Код" — не в Артикуле, подтверждено владельцем базы напрямую.
		// Кириллическое "ПБ" на экране выглядит почти так же, но это другой
		// префикс — старые/чужие позиции, их пропускаем. Поэтому здесь важно,
		// чтобы в этих кавычках стояла именно латиница, а не кириллица — при
		// правке этой строки набирайте "PB" на английской раскладке.
		Если Не СтрНачинаетсяС(ВРег(Код), "PB") Тогда
			Продолжить;
		КонецЕсли;

		Вес = Неопределено;
		Попытка
			Если ВесНаНоменклатуре Тогда Вес = ЧислоИлиПусто(Выборка.Ссылка.Вес); КонецЕсли;
			Если Вес = Неопределено И ВесНаЕдинице И Не ПустаяСтрока(ПолеЕдиницы)
				И ЗначениеЗаполнено(Выборка.Единица) Тогда
				Вес = ЧислоИлиПусто(Выборка.Единица.Вес);
			КонецЕсли;
		Исключение
			// Молчать здесь нельзя: ровно на этом месте вес не читался у всех
			// двенадцати тысяч позиций, а выгрузка выглядела успешной.
			// Пишем причину один раз — не двенадцать тысяч.
			Если ПустаяСтрока(ОшибкаВеса) Тогда
				ОшибкаВеса = ОписаниеОшибки();
			КонецЕсли;
		КонецПопытки;

		// Наш сервер понимает только lengthMm/widthMm/heightMm/weightG — единого
		// поля "объём" в модели товара нет намеренно, для подбора ячейки нужны
		// именно три измерения, а не итоговый м³. "Объём" (Объем) из 1С почти
		// никогда не раскладывается однозначно на длину/ширину/высоту, поэтому
		// сюда НЕ идёт — если у вас в базе всё же есть отдельные реквизиты для
		// каждого измерения, допишите их чтение по аналогии с Вес выше.
		// "Вес" в УТ 10.3 хранится в килограммах по умолчанию — переводим
		// в граммы, потому что так называется поле в нашем API (weightG).
		// Если в вашей базе единица веса другая — эту строку нужно поправить,
		// первую реальную выгрузку стоит свериться кнопкой «Выгрузить в файл».
		ВесВГраммах = Неопределено;
		Если Вес <> Неопределено Тогда
			ВесВГраммах = Вес * 1000;
		КонецЕсли;

		Стр = Новый Структура;
		Стр.Вставить("externalId", ИдентификаторСсылки(Выборка.Ссылка));
		Стр.Вставить("sku",        Код);
		Стр.Вставить("name",       СокрЛП(Выборка.Наименование));
		Стр.Вставить("category",   ?(ЗначениеЗаполнено(Выборка.Группа), СокрЛП(Строка(Выборка.Группа)), Неопределено));
		Стр.Вставить("weightG",    ВесВГраммах);
		// В этой базе у номенклатуры нет привязки к компании-продавцу —
		// companyExternalId не заполняем, компанию для этих товаров назначим
		// в личном кабинете Аргуса отдельно.
		Стр.Вставить("companyExternalId", Неопределено);

		// Штрихкод и резерв. Обоих может не быть — тогда поле просто не
		// поедет, и сервер оставит то, что у него уже есть, а не затрёт.
		Штрихкод = Штрихкоды[Код];
		Если Штрихкод <> Неопределено Тогда
			Стр.Вставить("barcode", Штрихкод);
		КонецЕсли;
		Резерв = Резервы[Код];
		Если Резерв <> Неопределено Тогда
			Стр.Вставить("reservedQty", Резерв);
		КонецЕсли;

		Результат.Добавить(Стр);

	КонецЦикла;

	Если Не ПустаяСтрока(ОшибкаВеса) Тогда
		ЗаписьЖурнала("Вес не прочитался ни у одной позиции: " + ОшибкаВеса);
	КонецЕсли;

	Возврат Результат;
КонецФункции


// Остатки товара на складах.
//
// Того, чего в обмене не было вовсе, — и из-за чего Аргус до сих пор не знал о
// складе ничего настоящего. Отправляем итог по артикулу: сколько всего этого
// товара числится в 1С. В какой он ячейке — Аргус узнаёт сам, когда работник
// туда что-то кладёт; раскладывать итог по ячейкам за 1С было бы выдумкой.
//
// Регистр ищем по метаданным, как штрихкоды и резервы: в разных конфигурациях
// он называется по-разному, а угадывать имя в коде — способ однажды молча
// отправить пустоту.
Функция СобратьОстаткиДляОтправки()
	Результат = Новый Массив;

	ИмяРегистра = НайтиРегистрНакопленияПоСлову("ТоварыНаСкладах");
	Если ИмяРегистра = Неопределено Тогда
		ИмяРегистра = НайтиРегистрНакопленияПоСлову("ОстаткиТоваров");
	КонецЕсли;
	Если ИмяРегистра = Неопределено Тогда
		ЗаписьЖурнала("Остатки: регистр не найден, отправлять нечего.");
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура.Код КАК Код,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления." + ИмяРегистра + ".Остатки КАК Остатки
	|ГДЕ
	|	НЕ Остатки.Номенклатура.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура.Код
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.КоличествоОстаток) <> 0";

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ЗаписьЖурнала("Остатки: запрос не выполнился — " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		Код = СокрЛП(Выборка.Код);
		// Тот же фильтр, что у номенклатуры: без него в остатки попадут
		// артикулы, которых в Аргусе нет и не будет.
		Если ПустаяСтрока(Код) Или Не СтрНачинаетсяС(ВРег(Код), "PB") Тогда
			Продолжить;
		КонецЕсли;
		Стр = Новый Структура;
		Стр.Вставить("sku", Код);
		Стр.Вставить("qty", Выборка.Количество);
		Результат.Добавить(Стр);
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция СобратьНакладныеДляОтправки()
	// Источник — "Заказ поставщику": заявленное количество товара ДО того,
	// как он физически приехал на склад. Это и есть накладная в смысле
	// Аргуса — работник сверяет с ней факт при приёмке. "Поступление"
	// (когда товар уже принят и остаток уже сдвинут) сюда сознательно не
	// идёт — иначе Аргус получал бы уже свершившийся факт, а не то, с чем
	// нужно сверяться.
	//
	// Ограничение по дате — чтобы не тащить в Аргус многолетнюю историю
	// старых, давно закрытых заказов, только недавние/актуальные.
	ДатаОт = НачалоДня(ТекущаяДата() - 60 * 24 * 60 * 60);

	Запрос = Новый Запрос;
	// Контрагент у документа — то, чего не хватало Аргусу, чтобы разделить
	// товар по продавцам. У номенклатуры такой привязки в этой базе нет, а у
	// документа есть всегда: приёмка кладёт товар в ячейку уже с правильным
	// владельцем. Реквизит проверяем: в чужой конфигурации он может
	// называться иначе, и падать из-за этого обмен не должен.
	ЕстьКонтрагент = ЕстьРеквизитДокумента("ЗаказПоставщику", "Контрагент");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗП.Ссылка КАК Ссылка,
	|	ЗП.Номер КАК Номер"
	+ ?(ЕстьКонтрагент, ",
	|	ЗП.Контрагент КАК Контрагент", "") + "
	|ИЗ
	|	Документ.ЗаказПоставщику КАК ЗП
	|ГДЕ
	|	ЗП.Проведен
	|	И ЗП.Дата >= &ДатаОт";
	Запрос.УстановитьПараметр("ДатаОт", ДатаОт);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		ЗапросПозиций = Новый Запрос;
		ЗапросПозиций.Текст =
		"ВЫБРАТЬ
		|	Т.Номенклатура.Код КАК Код,
		|	Т.Номенклатура.Наименование КАК Наименование,
		|	Т.Количество КАК Количество
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК Т
		|ГДЕ
		|	Т.Ссылка = &Ссылка";
		ЗапросПозиций.УстановитьПараметр("Ссылка", Выборка.Ссылка);

		Позиции = Новый Массив;
		ВыборкаПозиций = ЗапросПозиций.Выполнить().Выбрать();
		Пока ВыборкаПозиций.Следующий() Цикл
			Код = СокрЛП(ВыборкаПозиций.Код);
			// Тот же фильтр, что и в номенклатуре — берём только те позиции,
			// артикул которых мы вообще синхронизировали (латинский префикс
			// "PB" в "Коде"). Иначе в накладную попадут строки с SKU, которых
			// в Аргусе никогда не было.
			Если ПустаяСтрока(Код) Или Не СтрНачинаетсяС(ВРег(Код), "PB") Тогда
				Продолжить;
			КонецЕсли;

			СтрПозиции = Новый Структура;
			СтрПозиции.Вставить("sku", Код);
			СтрПозиции.Вставить("name", СокрЛП(ВыборкаПозиций.Наименование));
			СтрПозиции.Вставить("declaredQty", ЧислоИлиПусто(ВыборкаПозиций.Количество));
			Позиции.Добавить(СтрПозиции);
		КонецЦикла;

		Если Позиции.Количество() = 0 Тогда
			Продолжить; // ни одной узнаваемой позиции — нечего отправлять
		КонецЕсли;

		Стр = Новый Структура;
		Стр.Вставить("externalId", ИдентификаторСсылки(Выборка.Ссылка));
		Стр.Вставить("number", СокрЛП(Выборка.Номер));
		Стр.Вставить("direction", "in");
		// Продавец у документа. Идентификатор — тот же, что уходит при
		// отправке контрагентов: иначе Аргус компанию не найдёт. Поэтому
		// порядок обязателен — сначала контрагенты, потом накладные.
		Если ЕстьКонтрагент И ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			Стр.Вставить("companyExternalId", ИдентификаторСсылки(Выборка.Контрагент));
		КонецЕсли;
		Стр.Вставить("items", Позиции);

		Результат.Добавить(Стр);

	КонецЦикла;
	Возврат Результат;
КонецФункции


// ===================== Команды формы =====================

// Пишет строку в лог-файл вместо модального окна. Планировщик Windows
// запускает 1С без человека за экраном — Предупреждение() там никто не
// увидит и не закроет, вся синхронизация зависла бы навсегда. Файл кладётся
// в текущий рабочий каталог процесса 1С — его задаёт .bat через "cd /d",
// см. 1c-module/README.md, раздел про автозапуск по расписанию.
// Сводка по тому, что собралось: не «сколько строк», а чего в них не хватает.
// Именно этих цифр не хватает перед первой выгрузкой — по ним сразу видно,
// можно ли вообще на эту базу опираться.
Функция СобратьСводку(Контрагенты, Номенклатура)

	БезАртикула = 0;
	БезВеса     = 0;
	БезШтрихкода = 0;
	БезГруппы   = 0;
	Артикулы    = Новый Соответствие;
	Дубли       = 0;

	Для Каждого Товар Из Номенклатура Цикл
		Артикул = "";
		Если Товар.Свойство("sku") Тогда
			Артикул = СокрЛП(Строка(Товар.sku));
		КонецЕсли;

		Если ПустаяСтрока(Артикул) Тогда
			БезАртикула = БезАртикула + 1;
		ИначеЕсли Артикулы[ВРег(Артикул)] = Неопределено Тогда
			Артикулы.Вставить(ВРег(Артикул), 1);
		Иначе
			Дубли = Дубли + 1;
		КонецЕсли;

		Если Не Товар.Свойство("weightG") Или Товар.weightG = Неопределено Тогда
			БезВеса = БезВеса + 1;
		КонецЕсли;
		Если Не Товар.Свойство("barcode") Тогда
			БезШтрихкода = БезШтрихкода + 1;
		КонецЕсли;
		Если Не Товар.Свойство("category") Или Товар.category = Неопределено Тогда
			БезГруппы = БезГруппы + 1;
		КонецЕсли;
	КонецЦикла;

	Сводка = Новый Структура;
	Сводка.Вставить("counterparties",       Контрагенты.Количество());
	Сводка.Вставить("products",             Номенклатура.Количество());
	Сводка.Вставить("productsNoSku",        БезАртикула);
	Сводка.Вставить("productsDuplicateSku", Дубли);
	Сводка.Вставить("productsNoWeight",     БезВеса);
	Сводка.Вставить("productsNoBarcode",    БезШтрихкода);
	Сводка.Вставить("productsNoCategory",   БезГруппы);
	Возврат Сводка;

КонецФункции

Процедура ЗаписьЖурнала(Текст)
	Попытка
		// Абсолютный путь, не относительный: 1С в серверном режиме подключения
		// может сменить текущий рабочий каталог процесса при установлении
		// сеанса, и относительное "argus_sync.log" тогда пишется не туда, куда
		// ожидается (проверено живьём — файл с относительным путём не
		// появлялся вообще, без единой ошибки). Путь конкретного клиента,
		// при переносе на другой компьютер — поправить.
		Запись = Новый ЗаписьТекста("C:\Users\User7\Desktop\argus_sync.log", КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку(Строка(ТекущаяДата()) + "  " + Текст);
		Запись.Закрыть();
	Исключение
		// Не удалось записать лог (нет прав на каталог и т.п.) — прерывать
		// синхронизацию из-за этого не надо, само событие уже произошло.
	КонецПопытки;
КонецПроцедуры

// Общая точка вывода для всех команд ниже: интерактивно — модальное окно,
// как раньше; в автоматическом запуске (Тихо=Истина) — строка в лог-файл.
Процедура ПоказатьРезультат(Текст, Знач Тихо)
	Если Тихо Тогда
		ЗаписьЖурнала(СтрЗаменить(Текст, Символы.ПС, "; "));
	Иначе
		Предупреждение(Текст);
	КонецЕсли;
КонецПроцедуры


Процедура ПодключитьсяВыполнить(Кнопка, Знач Тихо = Ложь)

	// Платформа при вызове с кнопки формы подставляет необязательные
	// параметры явным Неопределено, а не значением по умолчанию — без этой
	// строки "Если Не Тихо Тогда" падает с "Преобразование к типу Булево
	// не может быть выполнено". Приводим к настоящему Булеву в любом случае.
	Тихо = (Тихо = Истина);

	Если ПустаяСтрока(КлючИнтеграции) Тогда
		ПоказатьРезультат("Введите ключ интеграции — его выдаёт владелец склада в личном кабинете Аргуса.", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
		Состояние("Подключение к Аргусу...");
	КонецЕсли;
	Ответ = ВыполнитьЗапрос("POST", "/api/sync/auth",
		Новый Структура("keyCode", СокрЛП(КлючИнтеграции)), Ложь);

	Если Не Ответ.Успех Тогда
		ПоказатьРезультат("Не удалось подключиться:" + Символы.ПС + Ответ.Ошибка, Тихо);
		Возврат;
	КонецЕсли;

	мТокенДоступа = Ответ.Тело.token;
	мИдСклада = Ответ.Тело.warehouseId;
	СтатусПодключения = "Подключено. Склад: " + мИдСклада;
	ПоказатьРезультат("Подключение установлено. Склад: " + мИдСклада, Тихо);

КонецПроцедуры


// Что модуль вообще нашёл в этой базе. Команда ничего не отправляет и ничего
// не меняет — она нужна до первой выгрузки, чтобы не гадать, почему поле
// приехало пустым.
// Поиск адресного хранения. Владелец базы говорит, что оно у него есть, —
// а первая версия проверки его не нашла, потому что искала только среди
// регистров накопления и только по словам «ячей» и «адресн».
//
// В УТ 10.3 адресного хранения нет штатно. Значит оно самописное, и назвать
// его могли как угодно: справочником, регистром сведений, реквизитом
// номенклатуры или колонкой в табличной части поступления. Поэтому ищем
// широко и по всем видам объектов, а не гадаем одно имя.
Функция ЭтоСловоПроАдрес(Имя)
	// "РЯД" сюда сознательно не входит: оно сидит внутри слова "ПОРЯДОК",
	// которого в любой конфигурации сотни, и отчёт утонул бы в мусоре.
	Слова = "ЯЧЕЙ,АДРЕС,СТЕЛЛАЖ,ПОЛК,МЕСТОХРАН,МЕСТАХРАН,МЕСТОСКЛАД,СЕКЦ,ЯРУС,ЗОНА,ХРАНЕН";
	ВИмени = ВРег(Имя);
	Поз = 1;
	Пока Истина Цикл
		Разделитель = Найти(Сред(Слова, Поз), ",");
		Если Разделитель = 0 Тогда
			Слово = Сред(Слова, Поз);
		Иначе
			Слово = Сред(Слова, Поз, Разделитель - 1);
		КонецЕсли;
		Если Не ПустаяСтрока(Слово) И Найти(ВИмени, Слово) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
		Если Разделитель = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = Поз + Разделитель;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Сколько записей в объекте. Именно количество, а не «объект существует»:
// сегодня уже был случай, когда регистр нашёлся, а внутри оказался ноль.
Функция СосчитатьЗаписи(ПолноеИмя)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ " + ПолноеИмя + " КАК Т";
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Возврат -1;
	КонецПопытки;
	Если Выборка.Следующий() Тогда
		Попытка
			Возврат Число(Выборка.Всего);
		Исключение
			Возврат -1;
		КонецПопытки;
	КонецЕсли;
	Возврат -1;
КонецФункции

// Перечислить поля объекта, похожие на адрес хранения.
Функция ПоляПроАдрес(Наборы)
	Итог = "";
	Для Каждого Набор Из Наборы Цикл
		Для Каждого Поле Из Набор Цикл
			Если ЭтоСловоПроАдрес(Поле.Имя) Тогда
				Итог = Итог + ?(ПустаяСтрока(Итог), "", ", ") + Поле.Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Итог;
КонецФункции

Процедура ИскатьАдресноеХранение(Строки)

	Строки.Добавить("");
	Строки.Добавить("=== Поиск адресного хранения ===");
	НашлиХотьЧто = Ложь;

	// 1. Справочники: «Ячейки», «МестаХранения» и подобные.
	Для Каждого М Из Метаданные.Справочники Цикл
		Если Не ЭтоСловоПроАдрес(М.Имя) Тогда
			Продолжить;
		КонецЕсли;
		НашлиХотьЧто = Истина;
		Строки.Добавить("Справочник." + М.Имя + " — элементов: "
			+ СосчитатьЗаписи("Справочник." + М.Имя));
	КонецЦикла;

	// 2. Регистры сведений: имя подходит ЛИБО внутри есть поле про адрес.
	//    Второе важнее: регистр может называться «РазмещениеТоваров».
	Для Каждого М Из Метаданные.РегистрыСведений Цикл
		Наборы = Новый Массив;
		Наборы.Добавить(М.Измерения); Наборы.Добавить(М.Реквизиты); Наборы.Добавить(М.Ресурсы);
		Поля = ПоляПроАдрес(Наборы);
		Если Не ЭтоСловоПроАдрес(М.Имя) И ПустаяСтрока(Поля) Тогда
			Продолжить;
		КонецЕсли;
		НашлиХотьЧто = Истина;
		ЕстьТовар = НайтиПолеНоменклатуры(М);
		Строки.Добавить("РегистрСведений." + М.Имя + " — записей: "
			+ СосчитатьЗаписи("РегистрСведений." + М.Имя));
		Строки.Добавить("      поля про адрес: " + ?(ПустаяСтрока(Поля), "нет", Поля)
			+ "; номенклатура: " + ?(ЕстьТовар = Неопределено, "НЕТ", ЕстьТовар));
	КонецЦикла;

	// 3. Регистры накопления — на случай, если остатки ведутся по ячейкам.
	Для Каждого М Из Метаданные.РегистрыНакопления Цикл
		Наборы = Новый Массив;
		Наборы.Добавить(М.Измерения); Наборы.Добавить(М.Реквизиты);
		Поля = ПоляПроАдрес(Наборы);
		Если Не ЭтоСловоПроАдрес(М.Имя) И ПустаяСтрока(Поля) Тогда
			Продолжить;
		КонецЕсли;
		НашлиХотьЧто = Истина;
		Строки.Добавить("РегистрНакопления." + М.Имя + " — записей: "
			+ СосчитатьЗаписи("РегистрНакопления." + М.Имя));
		Строки.Добавить("      поля про адрес: " + ?(ПустаяСтрока(Поля), "нет", Поля));
	КонецЦикла;

	// 4. Реквизиты самой номенклатуры: адрес может лежать прямо в карточке.
	МетаНом = Метаданные.Справочники.Найти("Номенклатура");
	Если МетаНом <> Неопределено Тогда
		Наборы = Новый Массив;
		Наборы.Добавить(МетаНом.Реквизиты);
		Поля = ПоляПроАдрес(Наборы);
		Если Не ПустаяСтрока(Поля) Тогда
			НашлиХотьЧто = Истина;
			Строки.Добавить("Реквизиты номенклатуры про адрес: " + Поля);
		КонецЕсли;
	КонецЕсли;

	// 5. Документы поступления: ячейку могли писать колонкой в табличной части.
	Для Каждого ИмяДок Из СтрокиДокументовПрихода() Цикл
		МетаДок = Метаданные.Документы.Найти(ИмяДок);
		Если МетаДок = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Наборы = Новый Массив;
		Наборы.Добавить(МетаДок.Реквизиты);
		Для Каждого ТЧ Из МетаДок.ТабличныеЧасти Цикл
			Наборы.Добавить(ТЧ.Реквизиты);
		КонецЦикла;
		Поля = ПоляПроАдрес(Наборы);
		Если Не ПустаяСтрока(Поля) Тогда
			НашлиХотьЧто = Истина;
			Строки.Добавить("Документ." + ИмяДок + " — поля про адрес: " + Поля);
		КонецЕсли;
	КонецЦикла;

	Если Не НашлиХотьЧто Тогда
		Строки.Добавить("Ничего похожего на адресное хранение не нашлось.");
		Строки.Добавить("Спросите у владельца базы, КАК он записывает ячейку:");
		Строки.Добавить("в каком документе или справочнике он её видит на экране.");
	КонецЕсли;

КонецПроцедуры

Функция СтрокиДокументовПрихода()
	Список = Новый Массив;
	Список.Добавить("ПоступлениеТоваровУслуг");
	Список.Добавить("ЗаказПоставщику");
	Список.Добавить("ПриходныйОрдерНаТовары");
	Список.Добавить("ПеремещениеТоваров");
	Список.Добавить("ОприходованиеТоваров");
	Возврат Список;
КонецФункции

Процедура ПроверитьБазуВыполнить(Кнопка)

	Строки = Новый Массив;
	Строки.Добавить("Что найдено в этой базе:");
	Строки.Добавить("");

	ЕстьКонтрагент = ЕстьРеквизитДокумента("ЗаказПоставщику", "Контрагент");
	Строки.Добавить("Контрагент у заказа поставщику: "
		+ ?(ЕстьКонтрагент, "есть — товар разделится по продавцам", "НЕТ"));

	// Все регистры со словом "Штрих" — и годные, и нет. Прошлый раз список
	// показал одно имя и ноль штрихкодов, и было не понять: настоящий регистр
	// пуст или его отбросил мой фильтр. Теперь видно каждый и причина отказа.
	Строки.Добавить("Регистры со словом «Штрих»:");
	ЕстьХотьОдин = Ложь;
	Для Каждого МетаР Из Метаданные.РегистрыСведений Цикл
		Если Найти(ВРег(МетаР.Имя), "ШТРИХ") = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЕстьХотьОдин = Истина;
		ПолеТовара = НайтиПолеНоменклатуры(МетаР);
		ПолеШК     = НайтиПолеПоСлову(МетаР, "ШТРИХ");
		Если ПолеТовара = Неопределено Тогда
			Строки.Добавить("   " + МетаР.Имя + " — пропущен: нет поля с номенклатурой");
		ИначеЕсли ПолеШК = Неопределено Тогда
			Строки.Добавить("   " + МетаР.Имя + " — пропущен: нет поля со штрихкодом");
		Иначе
			Свои = Новый Соответствие;
			Собрано = СобратьШтрихкодыИзРегистра(МетаР.Имя, Свои);
			// Сколько из них про НАШИ товары. Общая цифра ни о чём не говорит:
			// в базе есть чужая номенклатура, а нас интересуют коды на PB.
			Наших = 0;
			Для Каждого КлючЗначение Из Свои Цикл
				Если СтрНачинаетсяС(ВРег(КлючЗначение.Ключ), "PB") Тогда
					Наших = Наших + 1;
				КонецЕсли;
			КонецЦикла;
			Чужих = СосчитатьЧужиеВладельцы(МетаР.Имя);
			Строки.Добавить("   " + МетаР.Имя + " [" + ПолеТовара + "] — собрано "
				+ Собрано + ", из них наших (PB): " + Наших);
			Если Чужих > 0 Тогда
				Строки.Добавить("      строк не про номенклатуру (характеристики,"
					+ " серии): " + Чужих);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьХотьОдин Тогда
		Строки.Добавить("   таких регистров в базе нет");
	КонецЕсли;

	РегРез = НайтиРегистрНакопленияПоСлову("Резерв");
	Строки.Добавить("Регистр резервов: " + ?(РегРез = Неопределено, "НЕ НАЙДЕН", РегРез));
	Если РегРез <> Неопределено Тогда
		Резервы = СобратьРезервы();
		Строки.Добавить("   позиций в резерве: " + Резервы.Количество());
	КонецЕсли;

	РегОст = НайтиРегистрНакопленияПоСлову("ТоварыНаСкладах");
	Если РегОст = Неопределено Тогда
		РегОст = НайтиРегистрНакопленияПоСлову("ОстаткиТоваров");
	КонецЕсли;
	Строки.Добавить("Регистр остатков: " + ?(РегОст = Неопределено, "НЕ НАЙДЕН", РегОст));
	Если РегОст <> Неопределено Тогда
		Остатки = СобратьОстаткиДляОтправки();
		Строки.Добавить("   позиций с остатком (код на PB): " + Остатки.Количество());
	КонецЕсли;



	Если ЕстьРеквизитСправочника("Номенклатура", "Вес") Тогда
		Строки.Добавить("Вес: реквизит прямо у номенклатуры");
	ИначеЕсли ЕстьРеквизитСправочника("ЕдиницыИзмерения", "Вес")
		И ЕстьРеквизитСправочника("Номенклатура", "ЕдиницаХраненияОстатков") Тогда
		Строки.Добавить("Вес: через единицу хранения остатков");
	Иначе
		Строки.Добавить("Вес: взять неоткуда — придётся заполнять в Аргусе");
	КонецЕсли;

	// Чего не хватает в самих данных. Раньше ради этих цифр открывали
	// отдельную обработку и писали файл на диск.
	Номенклатура = СобратьНоменклатуруДляОтправки();
	Сводка = СобратьСводку(Новый Массив, Номенклатура);
	Строки.Добавить("");
	Строки.Добавить("Номенклатуры к выгрузке: " + Сводка.products);
	Строки.Добавить("   без веса: " + Сводка.productsNoWeight);
	Строки.Добавить("   без штрихкода: " + Сводка.productsNoBarcode);
	Строки.Добавить("   дублей артикула: " + Сводка.productsDuplicateSku);

	ИскатьАдресноеХранение(Строки);

	Текст = "";
	Для Каждого Стр Из Строки Цикл
		Текст = Текст + Стр + Символы.ПС;
	КонецЦикла;
	ЗаписьЖурнала(Текст);
	Предупреждение(Текст);

КонецПроцедуры

Процедура ОтправитьКонтрагентовВыполнить(Кнопка, Знач Тихо = Ложь)

	Тихо = (Тихо = Истина);

	Если ПустаяСтрока(мТокенДоступа) Тогда
		ПоказатьРезультат("Сначала нажмите «Подключиться».", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
		Состояние("Собираем контрагентов...");
	КонецЕсли;
	Записи = СобратьКонтрагентовДляОтправки();
	Если Записи.Количество() = 0 Тогда
		ПоказатьРезультат("Контрагентов для отправки не найдено.", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
		Состояние("Отправляем " + Записи.Количество() + " контрагентов...");
	КонецЕсли;
	Ответ = ВыполнитьЗапрос("POST", "/api/sync/push/companies", Новый Структура("records", Записи));

	Если Не Ответ.Успех Тогда
		ПоказатьРезультат("Ошибка отправки:" + Символы.ПС + Ответ.Ошибка, Тихо);
		Возврат;
	КонецЕсли;

	ПоказатьСводкуОтправки("Контрагенты", Ответ.Тело, Тихо);

КонецПроцедуры


Процедура ОтправитьНоменклатуруВыполнить(Кнопка, Знач Тихо = Ложь)

	Тихо = (Тихо = Истина);

	Если ПустаяСтрока(мТокенДоступа) Тогда
		ПоказатьРезультат("Сначала нажмите «Подключиться».", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
		Состояние("Собираем номенклатуру...");
	КонецЕсли;
	Записи = СобратьНоменклатуруДляОтправки();
	Если Записи.Количество() = 0 Тогда
		ПоказатьРезультат("Номенклатуры для отправки не найдено (возможно, не заполнены артикулы).", Тихо);
		Возврат;
	КонецЕсли;

	// Отправляем пачками по 500 — ровно лимит на стороне сервера, см. sync/routes.js.
	РазмерПачки = 500;
	Номер = 0;
	ВсегоСоздано = 0; ВсегоОбновлено = 0; ВсегоОшибок = 0;
	Проблемные = Новый Массив;
	Пока Номер < Записи.Количество() Цикл
		Пачка = Новый Массив;
		Граница = Мин(Номер + РазмерПачки, Записи.Количество());
		Для Инд = Номер По Граница - 1 Цикл
			Пачка.Добавить(Записи[Инд]);
		КонецЦикла;

		Если Не Тихо Тогда
			Состояние("Отправляем позиции " + (Номер + 1) + "–" + Граница + " из " + Записи.Количество() + "...");
		КонецЕсли;
		// "HappyLand Test" — компания, заранее созданная владельцем в кабинете
		// Аргуса. В этой базе номенклатура не привязана к контрагенту, поэтому
		// весь пуш идёт под одну явно указанную компанию, а не по externalId.
		Тело = Новый Структура;
		Тело.Вставить("records", Пачка);
		Тело.Вставить("defaultCompanyName", "HappyLand Test");
		Ответ = ВыполнитьЗапрос("POST", "/api/sync/push/products", Тело);
		Если Не Ответ.Успех Тогда
			ПоказатьРезультат("Ошибка отправки пачки " + (Номер + 1) + "–" + Граница + ":" + Символы.ПС + Ответ.Ошибка, Тихо);
			Возврат;
		КонецЕсли;

		Если Ответ.Тело.summary.Свойство("created") Тогда ВсегоСоздано = ВсегоСоздано + Ответ.Тело.summary.created; КонецЕсли;
		Если Ответ.Тело.summary.Свойство("updated") Тогда ВсегоОбновлено = ВсегоОбновлено + Ответ.Тело.summary.updated; КонецЕсли;
		Если Ответ.Тело.summary.Свойство("error") Тогда ВсегоОшибок = ВсегоОшибок + Ответ.Тело.summary.error; КонецЕсли;
		СобратьПроблемные(Ответ.Тело, Проблемные);

		Номер = Граница;
	КонецЦикла;

	ПоказатьРезультат("Готово." + Символы.ПС
		+ "Создано: " + ВсегоСоздано + Символы.ПС
		+ "Обновлено: " + ВсегоОбновлено + Символы.ПС
		+ "Ошибок: " + ВсегоОшибок + Символы.ПС
		+ ТекстПроблемных(Проблемные, ВсегоОшибок) + Символы.ПС
		+ Символы.ПС
		+ "Если ошибок много — скорее всего, у товаров не заполнен контрагент "
		+ "(companyExternalId). См. комментарий в коде функции сбора номенклатуры.", Тихо);

КонецПроцедуры


Процедура ОтправитьНакладныеВыполнить(Кнопка, Знач Тихо = Ложь)

	Тихо = (Тихо = Истина);

	Если ПустаяСтрока(мТокенДоступа) Тогда
		ПоказатьРезультат("Сначала нажмите «Подключиться».", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
		Состояние("Собираем заказы поставщику...");
	КонецЕсли;
	Записи = СобратьНакладныеДляОтправки();
	Если Записи.Количество() = 0 Тогда
		ПоказатьРезультат("Накладных для отправки не найдено (за последние 60 дней нет проведённых заказов поставщику с узнаваемыми позициями).", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
		Состояние("Отправляем " + Записи.Количество() + " накладных...");
	КонецЕсли;
	Тело = Новый Структура;
	Тело.Вставить("records", Записи);
	Тело.Вставить("defaultCompanyName", "HappyLand Test");
	Ответ = ВыполнитьЗапрос("POST", "/api/sync/push/invoices", Тело);

	Если Не Ответ.Успех Тогда
		ПоказатьРезультат("Ошибка отправки:" + Символы.ПС + Ответ.Ошибка, Тихо);
		Возврат;
	КонецЕсли;

	ПоказатьСводкуОтправки("Накладные", Ответ.Тело, Тихо);

КонецПроцедуры


// Адреса хранения: какой товар в какой ячейке лежит.
//
// В базе клиента это «РегистрСведений.ЯчейкиТоваров» — ни «адресн», ни «ячейк»
// в первом варианте поиска не подошло, регистр нашёлся только когда стали
// смотреть на поля, а не на имя. Поэтому и здесь ищем по СОДЕРЖИМОМУ: нужен
// регистр, где есть и товар, и что-то похожее на ячейку, и где есть записи.
Функция НайтиРегистрАдресов()
	Результат = Новый Структура("Имя,ПолеТовара,ПолеЯчейки,ПолеКоличества", "", "", "", "");

	Для Каждого М Из Метаданные.РегистрыСведений Цикл
		ПолеТовара = НайтиПолеНоменклатуры(М);
		Если ПолеТовара = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Наборы = Новый Массив;
		Наборы.Добавить(М.Измерения); Наборы.Добавить(М.Реквизиты); Наборы.Добавить(М.Ресурсы);
		ПолеЯчейки = "";
		Для Каждого Набор Из Наборы Цикл
			Для Каждого Поле Из Набор Цикл
				Если Найти(ВРег(Поле.Имя), "ЯЧЕЙ") > 0 Или Найти(ВРег(Поле.Имя), "МЕСТОХРАН") > 0
					Или Найти(ВРег(Поле.Имя), "СТЕЛЛАЖ") > 0 Тогда
					ПолеЯчейки = Поле.Имя;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не ПустаяСтрока(ПолеЯчейки) Тогда Прервать; КонецЕсли;
		КонецЦикла;
		Если ПустаяСтрока(ПолеЯчейки) Тогда
			Продолжить;
		КонецЕсли;

		// Пустой регистр — не находка. Именно на этом обжёгся поиск штрихкодов:
		// имя подошло, а внутри был ноль, и это выглядело как успех.
		Если СосчитатьЗаписи("РегистрСведений." + М.Имя) <= 0 Тогда
			Продолжить;
		КонецЕсли;

		ПолеКол = "";
		Для Каждого Ресурс Из М.Ресурсы Цикл
			Если Найти(ВРег(Ресурс.Имя), "КОЛИЧЕСТВ") > 0 Тогда
				ПолеКол = Ресурс.Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Результат.Имя = М.Имя;
		Результат.ПолеТовара = ПолеТовара;
		Результат.ПолеЯчейки = ПолеЯчейки;
		Результат.ПолеКоличества = ПолеКол;
		Возврат Результат;
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция СобратьАдресаДляОтправки()
	Результат = Новый Массив;

	Рег = НайтиРегистрАдресов();
	Если ПустаяСтрока(Рег.Имя) Тогда
		ЗаписьЖурнала("Адреса: регистр с ячейками не найден, отправлять нечего.");
		Возврат Результат;
	КонецЕсли;

	Товар = "ВЫРАЗИТЬ(Р." + Рег.ПолеТовара + " КАК Справочник.Номенклатура)";
	ПолеКол = ?(ПустаяСтрока(Рег.ПолеКоличества), "0", "Р." + Рег.ПолеКоличества);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	" + Товар + ".Код КАК Код,
	|	Р." + Рег.ПолеЯчейки + " КАК Ячейка,
	|	" + ПолеКол + " КАК Количество
	|ИЗ
	|	РегистрСведений." + Рег.Имя + " КАК Р
	|ГДЕ
	|	НЕ " + Товар + ".ПометкаУдаления";

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		ЗаписьЖурнала("Адреса: запрос не выполнился — " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл
		Код = СокрЛП(Строка(Выборка.Код));
		Ячейка = СокрЛП(Строка(Выборка.Ячейка));
		// Тот же фильтр, что у номенклатуры и остатков: чужие коды в Аргусе
		// всё равно не к чему привязать.
		Если ПустаяСтрока(Код) Или Не СтрНачинаетсяС(ВРег(Код), "PB") Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(Ячейка) Тогда
			Продолжить;
		КонецЕсли;
		Стр = Новый Структура;
		Стр.Вставить("sku", Код);
		Стр.Вставить("cell", Ячейка);
		Если Не ПустаяСтрока(Рег.ПолеКоличества) Тогда
			Стр.Вставить("qty", Выборка.Количество);
		КонецЕсли;
		Результат.Добавить(Стр);
	КонецЦикла;

	Возврат Результат;
КонецФункции

Процедура ОтправитьОстаткиВыполнить(Кнопка, Знач Тихо = Ложь)

	Тихо = (Тихо = Истина);

	Если ПустаяСтрока(мТокенДоступа) Тогда
		ПоказатьРезультат("Сначала нажмите «Подключиться».", Тихо);
		Возврат;
	КонецЕсли;

	Если Не Тихо Тогда
		Состояние("Считаем остатки...");
	КонецЕсли;
	Записи = СобратьОстаткиДляОтправки();
	Если Записи.Количество() = 0 Тогда
		ПоказатьРезультат("Остатков для отправки не найдено. Нажмите «Проверить базу» —"
			+ " там видно, нашёлся ли регистр остатков.", Тихо);
		Возврат;
	КонецЕсли;

	РазмерПачки = 500;
	Номер = 0;
	ВсегоОбновлено = 0; ВсегоОшибок = 0;
	Проблемные = Новый Массив;
	Пока Номер < Записи.Количество() Цикл
		Пачка = Новый Массив;
		Граница = Мин(Номер + РазмерПачки, Записи.Количество());
		Для Инд = Номер По Граница - 1 Цикл
			Пачка.Добавить(Записи[Инд]);
		КонецЦикла;

		Если Не Тихо Тогда
			Состояние("Отправляем остатки " + (Номер + 1) + "–" + Граница
				+ " из " + Записи.Количество() + "...");
		КонецЕсли;

		Тело = Новый Структура;
		Тело.Вставить("records", Пачка);
		Тело.Вставить("defaultCompanyName", "HappyLand Test");
		Ответ = ВыполнитьЗапрос("POST", "/api/sync/push/stock", Тело);
		Если Не Ответ.Успех Тогда
			ПоказатьРезультат("Ошибка отправки остатков " + (Номер + 1) + "–" + Граница
				+ ":" + Символы.ПС + Ответ.Ошибка, Тихо);
			Возврат;
		КонецЕсли;

		Если Ответ.Тело.summary.Свойство("updated") Тогда
			ВсегоОбновлено = ВсегоОбновлено + Ответ.Тело.summary.updated;
		КонецЕсли;
		Если Ответ.Тело.summary.Свойство("error") Тогда
			ВсегоОшибок = ВсегоОшибок + Ответ.Тело.summary.error;
		КонецЕсли;

		СобратьПроблемные(Ответ.Тело, Проблемные);

		Номер = Граница;
	КонецЦикла;

	Итог = "Остатки отправлены." + Символы.ПС
		+ "Обновлено позиций: " + ВсегоОбновлено + Символы.ПС
		+ "Ошибок: " + ВсегоОшибок;

	Итог = Итог + Символы.ПС + ТекстПроблемных(Проблемные, ВсегоОшибок);

	Итог = Итог + Символы.ПС + Символы.ПС
		+ "Если ошибок много — скорее всего, номенклатуру ещё не выгружали:"
		+ " остаток кладётся к карточке товара, а не создаёт её.";

	// Адреса едут следом и той же кнопкой: «где лежит» и «сколько лежит» —
	// один вопрос, и разделять их на две кнопки значит однажды получить
	// свежие количества при позапрошлогодней раскладке.
	Адреса = СобратьАдресаДляОтправки();
	Если Адреса.Количество() > 0 Тогда
		НомерА = 0; ВсегоАдресов = 0; ОшибокАдресов = 0;
		Пока НомерА < Адреса.Количество() Цикл
			ПачкаА = Новый Массив;
			ГраницаА = Мин(НомерА + РазмерПачки, Адреса.Количество());
			Для Инд = НомерА По ГраницаА - 1 Цикл
				ПачкаА.Добавить(Адреса[Инд]);
			КонецЦикла;
			Если Не Тихо Тогда
				Состояние("Отправляем адреса " + (НомерА + 1) + "–" + ГраницаА
					+ " из " + Адреса.Количество() + "...");
			КонецЕсли;
			ТелоА = Новый Структура;
			ТелоА.Вставить("records", ПачкаА);
			ТелоА.Вставить("defaultCompanyName", "HappyLand Test");
			ОтветА = ВыполнитьЗапрос("POST", "/api/sync/push/cells", ТелоА);
			Если Не ОтветА.Успех Тогда
				Итог = Итог + Символы.ПС + Символы.ПС + "Адреса отправить не удалось: " + ОтветА.Ошибка;
				Прервать;
			КонецЕсли;
			Если ОтветА.Тело.summary.Свойство("updated") Тогда
				ВсегоАдресов = ВсегоАдресов + ОтветА.Тело.summary.updated;
			КонецЕсли;
			Если ОтветА.Тело.summary.Свойство("error") Тогда
				ОшибокАдресов = ОшибокАдресов + ОтветА.Тело.summary.error;
			КонецЕсли;
			НомерА = ГраницаА;
		КонецЦикла;
		Итог = Итог + Символы.ПС + Символы.ПС
			+ "Адресов хранения отправлено: " + ВсегоАдресов
			+ ?(ОшибокАдресов > 0, ", ошибок: " + ОшибокАдресов, "");
	Иначе
		Итог = Итог + Символы.ПС + Символы.ПС
			+ "Адресов хранения не нашлось — см. «Проверить базу», раздел про адресное хранение.";
	КонецЕсли;

	ПоказатьРезультат(Итог, Тихо);

КонецПроцедуры

// Выгрузка в файл — то, что раньше было отдельной обработкой.
//
// Ничего никуда не отправляет: пишет один JSON на диск, чтобы можно было
// посмотреть глазами, что вообще есть в базе, ДО того как это увидит сервер.
// Собирает теми же функциями, что и настоящая выгрузка, — иначе файл
// показывал бы одно, а на сервер уезжало бы другое.
Процедура ВыгрузитьВФайлВыполнить(Кнопка)

	Если ПустаяСтрока(ПутьФайла) Тогда
		Предупреждение("Укажите, куда сохранить файл");
		Возврат;
	КонецЕсли;

	Состояние("Аргус: читаем справочники...");
	Попытка
		Контрагенты  = СобратьКонтрагентовДляОтправки();
		Номенклатура = СобратьНоменклатуруДляОтправки();
		Накладные    = СобратьНакладныеДляОтправки();
		Остатки      = СобратьОстаткиДляОтправки();
	Исключение
		Предупреждение("Не удалось прочитать данные:" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Выгрузка = Новый Структура;
	Выгрузка.Вставить("source",         "1C");
	Выгрузка.Вставить("exportedAt",     Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Выгрузка.Вставить("summary",        СобратьСводку(Контрагенты, Номенклатура));
	Выгрузка.Вставить("counterparties", Контрагенты);
	Выгрузка.Вставить("products",       Номенклатура);
	Выгрузка.Вставить("invoices",       Накладные);
	Выгрузка.Вставить("stock",          Остатки);

	Попытка
		Запись = Новый ЗаписьJSON;
		Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
		Запись.ОткрытьФайл(ПутьФайла, "UTF-8", Ложь, Параметры);
		ЗаписатьJSON(Запись, Выгрузка);
		Запись.Закрыть();
	Исключение
		Предупреждение("Не удалось записать файл:" + Символы.ПС + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	С = Выгрузка.summary;
	Текст = "Файл записан: " + ПутьФайла + Символы.ПС + Символы.ПС
		+ "Контрагентов: " + С.counterparties + Символы.ПС
		+ "Номенклатуры: " + С.products + Символы.ПС
		+ "Накладных: "    + Накладные.Количество() + Символы.ПС
		+ "Позиций с остатком: " + Остатки.Количество() + Символы.ПС + Символы.ПС
		+ "Без артикула: "    + С.productsNoSku + Символы.ПС
		+ "Дублей артикула: " + С.productsDuplicateSku + Символы.ПС
		+ "Без веса: "        + С.productsNoWeight + Символы.ПС
		+ "Без штрихкода: "   + С.productsNoBarcode + Символы.ПС
		+ "Без группы: "      + С.productsNoCategory;

	ЗаписьЖурнала(Текст);
	Предупреждение(Текст);

КонецПроцедуры

// Имена того, что не легло, а не только их количество. «Ошибок: 3» без имён —
// тупик: чтобы найти три позиции среди двенадцати тысяч, пришлось бы сличать
// выгрузку с базой руками. Больше десяти не собираем: при настоящей поломке
// окно станет нечитаемым, а причина у всех будет одна и та же.
Процедура СобратьПроблемные(ТелоОтвета, Проблемные)

	Если Не ТелоОтвета.Свойство("results") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Стр Из ТелоОтвета.results Цикл
		Если Проблемные.Количество() >= 10 Тогда
			Прервать;
		КонецЕсли;
		Если Не Стр.Свойство("status") Или Стр.status <> "error" Тогда
			Продолжить;
		КонецЕсли;

		// Сервер называет позицию по-разному: остатки по артикулу, номенклатуру
		// и накладные по внешнему идентификатору. Берём то, что есть.
		Имя = "(без имени)";
		Если Стр.Свойство("sku") И ЗначениеЗаполнено(Стр.sku) Тогда
			Имя = Строка(Стр.sku);
		ИначеЕсли Стр.Свойство("externalId") И ЗначениеЗаполнено(Стр.externalId) Тогда
			Имя = Строка(Стр.externalId);
		КонецЕсли;
		Если Стр.Свойство("error") И ЗначениеЗаполнено(Стр.error) Тогда
			Имя = Имя + " — " + Строка(Стр.error);
		КонецЕсли;
		Проблемные.Добавить(Имя);
	КонецЦикла;

КонецПроцедуры

Функция ТекстПроблемных(Проблемные, Знач ВсегоОшибок = 0)
	Если Проблемные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Текст = Символы.ПС + "Не легли:";
	Для Каждого Стр Из Проблемные Цикл
		Текст = Текст + Символы.ПС + "   " + Стр;
	КонецЦикла;
	Если ВсегоОшибок > Проблемные.Количество() Тогда
		Текст = Текст + Символы.ПС + "   ...и ещё " + (ВсегоОшибок - Проблемные.Количество());
	КонецЕсли;
	Возврат Текст;
КонецФункции

Процедура ПоказатьСводкуОтправки(Заголовок, ТелоОтвета, Знач Тихо = Ложь)
	Текст = Заголовок + " — готово." + Символы.ПС;
	Для Каждого Ключ Из ТелоОтвета.summary Цикл
		Текст = Текст + Ключ.Ключ + ": " + Ключ.Значение + Символы.ПС;
	КонецЦикла;

	Проблемные = Новый Массив;
	СобратьПроблемные(ТелоОтвета, Проблемные);
	Ошибок = 0;
	Если ТелоОтвета.summary.Свойство("error") Тогда
		Ошибок = ТелоОтвета.summary.error;
	КонецЕсли;
	Текст = Текст + ТекстПроблемных(Проблемные, Ошибок);

	ПоказатьРезультат(Текст, Тихо);
КонецПроцедуры


Процедура ПриОткрытии()
	мТокенДоступа = "";
	СтатусПодключения = "Не подключено";
	Если ПустаяСтрока(ПутьФайла) Тогда
		ПутьФайла = "C:\argus_1c_export.json";
	КонецЕсли;

	// Пишем безусловно, первой же строкой: это единственный способ отличить
	// "обработка не запустилась вовсе" от "запустилась, но ключ не доехал".
	// Без этой строки оба случая выглядят одинаково — пустой лог.
	ЗаписьЖурнала("Запуск. ПараметрЗапуска=[" + Строка(ПараметрЗапуска) + "]");

	// Планировщик Windows запускает 1cv8.exe с /C "КЛЮЧ_ИНТЕГРАЦИИ" /Execute
	// "путь\АргусСинхронизация.epf" — тогда платформа кладёт значение /C в
	// ПараметрЗапуска. Обычное "Файл → Открыть" человеком всегда даёт пустой
	// ПараметрЗапуска, так что это не меняет ручной сценарий работы.
	Если Не ПустаяСтрока(ПараметрЗапуска) Тогда
		КлючИнтеграции = СокрЛП(ПараметрЗапуска);
		ПодключитьсяВыполнить(Неопределено, Истина);
		Если Не ПустаяСтрока(мТокенДоступа) Тогда
			// Контрагентов намеренно НЕ отправляем: владелец базы подтвердил,
			// что справочник старый и нерелевантный, а товары привязываются к
			// одной компании через defaultCompanyName. Плюс их отправка не
			// разбита на пачки по 500 и упирается в лимит сервера (413).
			ОтправитьНоменклатуруВыполнить(Неопределено, Истина);
			ОтправитьНакладныеВыполнить(Неопределено, Истина);
			// Остатки — последними и обязательно: они меняются каждый день,
			// и обмен без них оставляет Аргус со вчерашней картиной.
			ОтправитьОстаткиВыполнить(Неопределено, Истина);
		КонецЕсли;
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;
КонецПроцедуры
